<Project>
	<PropertyGroup>
		<!-- The package version. Bump it after each stable release; 6.0.0 to 6.0.3 already exist on nuget.org. -->
		<Version>6.0.4</Version>
		<!-- Keeps the assembly identity that consumers compile against while the package version moves. -->
		<AssemblyVersion>6.0.0.0</AssemblyVersion>
		<RoslynPackageVersion>4.13.0-3.24620.4</RoslynPackageVersion>
		<WarningsAsErrors>true</WarningsAsErrors>
		<UseWPF Condition="$(TargetFramework) == 'net6.0-windows'">true</UseWPF>
	</PropertyGroup>
	<ItemGroup Condition="$(AssemblyName) != 'System.Xaml' AND $(TargetFramework) != 'net6.0-windows'">
		<ProjectReference Include="$(SolutionDir)\System.Xaml\System.Xaml.csproj" PrivateAssets="All" />
	</ItemGroup>
</Project>